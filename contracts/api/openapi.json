          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": false
      },
      "ClaimRequest": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "wait_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25
          }
        },
        "required": [
          "worker_id",
          "instance_id",
          "request_id",
          "wait_s"
        ],
        "additionalProperties": false,
        "description": "Idempotent claim. Nonempty receipts retained with attempts; empty receipts replay for at least 300 seconds."
      },
      "Ack": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "lease_id": {
            "type": "string",
            "format": "uuid"
          },
          "worker_job_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "worker_id",
          "instance_id",
          "lease_id",
          "worker_job_id"
        ],
        "additionalProperties": false
      },
      "JobEvent": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
