            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "assignment": {
            "$ref": "#/components/schemas/Assignment"
          },
          "record": {
            "$ref": "#/components/schemas/JobRecord"
          }
        },
        "required": [
          "event_id",
          "event_seq",
          "assignment",
          "record"
        ],
        "additionalProperties": false
      },
      "Error": {
