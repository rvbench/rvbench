            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "state",
          "origin",
          "count"
        ],
        "additionalProperties": false
      },
      "ObservedWorker": {
        "type": "object",
