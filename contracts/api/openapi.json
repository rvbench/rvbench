            "type": "boolean"
          },
          "drained": {
            "type": "boolean"
          },
          "pending_ack": {
            "type": "integer",
            "minimum": 0
          },
          "acknowledged": {
            "type": "integer",
            "minimum": 0
          },
          "uncertain": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
