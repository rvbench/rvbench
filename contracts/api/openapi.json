            "type": "boolean",
            "description": "auth.mode != off"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "github",
              "oidc",
              "static",
              null
            ]
          },
          "display_name": {
            "type": "string",
