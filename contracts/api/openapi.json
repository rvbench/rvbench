              "$ref": "#/components/schemas/JobKind"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "delivery": {
            "$ref": "#/components/schemas/DeliveryMode"
          },
          "url": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "direct_active": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "ready": {
            "type": "boolean"
          },
          "environment": {
            "type": "object",
            "additionalProperties": true
          },
          "protocol_version": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "observability": {
            "$ref": "#/components/schemas/ObservabilityRegistration"
          }
        },
        "required": [
          "worker_id",
          "board_id",
          "instance_id",
          "backend",
          "kinds",
          "delivery",
          "url",
          "capacity",
          "direct_active",
          "ready",
          "environment",
          "protocol_version"
        ],
        "additionalProperties": false
      },
      "Assignment": {
        "type": "object",
