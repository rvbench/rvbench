            ]
          },
          "metrics_path": {
            "type": "string",
            "enum": [
              "/metrics"
            ]
          },
          "host_metrics_url": {
            "type": "string",
            "pattern": "^http://[^/]+/metrics$"
          }
        },
        "required": [
          "metrics_version",
          "metrics_path"
        ],
        "additionalProperties": false
      },
      "CountEntry": {
        "type": "object",
        "properties": {
