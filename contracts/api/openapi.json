      "TokenExchangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "GitHub OAuth access token（device flow 产物）；static provider 下为 login"
          }
        }
      },
      "TokenExchangeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "token_type",
          "expires_at",
          "principal"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^rvb_[A-Za-z0-9_-]{40,}$",
            "description": "只在此响应中出现一次"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          }
        }
      },
      "Principal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sub",
          "login",
          "roles"
        ],
        "properties": {
          "sub": {
            "type": "string",
            "pattern": "^(github:[0-9]+|worker:[A-Za-z0-9_-]{1,64})$",
            "description": "稳定的 provider 主体标识；login 改名不影响。\nworker:<worker_id> 表示机器主体（provider=worker），与用户角色互斥。\n"
          },
          "login": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "oidc",
              "static",
              "worker"
            ]
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "sub": {
                  "pattern": "^worker:"
                }
              }
            },
            "then": {
              "properties": {
                "provider": {
                  "const": "worker"
                },
                "roles": {
                  "contains": {
                    "const": "worker"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "sub": {
                  "pattern": "^github:"
                }
              }
            },
            "then": {
              "properties": {
                "provider": {
                  "enum": [
                    "github",
                    "oidc",
                    "static"
                  ]
                },
                "roles": {
                  "not": {
                    "contains": {
                      "const": "worker"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "CurrentUser": {
        "type": "object",
        "additionalProperties": false,
